# ============================================================
# Clinical AI Copilot — environment variables (template)
#
# Copy this file to `.env` (repository root) and adjust values:
#     cp .env.example .env
#
# NEVER commit real credentials to the repository.
# ============================================================

# ---- PostgreSQL ----
POSTGRES_DB=clinical_ai_copilot
POSTGRES_USER=clinical_user
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# ---- MinIO (S3-compatible object storage) ----
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=change-me
MINIO_BUCKET=clinical-documents
# Host ports exposed by docker-compose
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# ---- Backend ----
BACKEND_PORT=8000

# ---- Authentication (Task 18) ----
# JWT_SECRET_KEY MUST be changed for any non-development deployment.
# Generate one with:  python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=dev-only-insecure-secret-change-me
JWT_ALGORITHM=HS256
# Access-token lifetime in minutes (default: 8-hour clinical shift).
JWT_EXPIRE_MINUTES=480
# Demo users (development seed ONLY — see backend/scripts/seed.py):
#   admin@example.com  / admin-dev-12345   (role: admin)
#   doctor@example.com / doctor-dev-12345  (role: doctor)

# ---- Speech-to-Text (provider-agnostic; Speechmatics — https://speechmatics.com) ----
# STT_PROVIDER selects the implementation (services/stt.py); only
# "speechmatics" exists for now — adding a provider needs no workflow change.
# STT_API_KEY empty falls back to SPEECHMATICS_API_KEY (legacy spelling).
# Empty key = Persian transcription stays `failed` with a logged reason until set.
STT_PROVIDER=speechmatics
STT_API_KEY=
STT_LANGUAGE=fa
SPEECHMATICS_API_KEY=

# ---- AI assistant (provider-agnostic; no real secrets here) ----
# AI_PROVIDER: gemini (native Google Gemini API) | openrouter
#              (https://openrouter.ai — needs OPENROUTER_API_KEY)
#              | openai_compatible (any OpenAI-style API via AI_BASE_URL)
# Gemini:  set AI_PROVIDER=gemini       + AI_API_KEY=<Google AI Studio key>
# OpenRouter: set AI_PROVIDER=openrouter + OPENROUTER_API_KEY=<openrouter key>
#   (free test model: AI_MODEL=deepseek/deepseek-r1:free)
# Empty key = clinical chat returns 503 with a Persian message.
# AI_MODEL empty = provider default (gemini-3.6-flash / deepseek-r1:free / gpt-4o-mini).
AI_PROVIDER=gemini
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=

# ---- OpenRouter (only used when AI_PROVIDER=openrouter) ----
OPENROUTER_API_KEY=

# ---- Frontend ----
# Public base URL of the backend API (used by the Next.js frontend)
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
