# ============================================================
# Clinical AI Copilot — environment variables (template)
#
# Copy this file to `.env` (repository root) and adjust values:
#     cp .env.example .env
#
# NEVER commit real credentials to the repository.
# ============================================================

# ---- PostgreSQL ----
POSTGRES_DB=clinical_ai_copilot
POSTGRES_USER=clinical_user
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# ---- MinIO (S3-compatible object storage) ----
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=change-me
MINIO_BUCKET=clinical-documents
# Host ports exposed by docker-compose
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# ---- Backend ----
BACKEND_PORT=8000

# ---- Frontend ----
# Public base URL of the backend API (used by the Next.js frontend)
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
