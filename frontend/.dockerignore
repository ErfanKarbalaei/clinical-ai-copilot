# Never bake secrets or local state into the image
.env
.env.*
*.env

# Build output & dependencies (rebuilt inside the image)
node_modules/
.next/
out/
*.tsbuildinfo
next-env.d.ts

# VCS / IDE / OS
.git/
.gitignore
.idea/
.vscode/
.DS_Store
Thumbs.db

# Docker files themselves
Dockerfile
.dockerignore
docker-compose*.yml

# Logs & misc local files
*.log
npm-debug.log*
coverage/
